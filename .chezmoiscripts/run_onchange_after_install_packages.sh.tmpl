#!/bin/bash
# packages hash: {{ include "dot_config/mise/config.toml" | sha256sum }}

set -euo pipefail

MISE_INSTALL_PATH="${MISE_INSTALL_PATH:-$HOME/.local/bin/mise}"
MISE_BIN_DIR="$(dirname "$MISE_INSTALL_PATH")"
export PATH="$MISE_BIN_DIR:$PATH"

if [ ! -f "$MISE_INSTALL_PATH" ]; then
  curl https://mise.run | sh
fi

"$MISE_INSTALL_PATH" trust {{ .chezmoi.homeDir }}/.config/mise
"$MISE_INSTALL_PATH" install
"$MISE_INSTALL_PATH" reshim

eval "$($MISE_INSTALL_PATH activate bash)"

if command -v herdr > /dev/null ; then
  if [[ -z "$(herdr plugin list | grep thanhdat77/herdr-navigator)" ]] > /dev/null ; then
    herdr plugin install thanhdat77/herdr-navigator -y
  else
    echo "Skipped herdr-navigator plugin install; already installed."
  fi
else
  echo "WARNING: herdr not found."
fi

echo "All set. Load a new terminal/zsh"
echo "  OR run: source ~/.zshrc"

